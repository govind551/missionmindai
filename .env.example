# MissionMind AI - Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missionmind_db
JWT_SECRET_KEY=missionmind-ai-super-secret-jwt-key-for-aerospace-security-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Options: "gemini", "openai", "groq", "local_heuristic")
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Embeddings (Options: "local", "gemini", "openai")
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# Speech-to-Text & Text-to-Speech (Options: "browser", "openai", "disabled")
STT_PROVIDER=browser
STT_API_KEY=
TTS_PROVIDER=browser
TTS_API_KEY=

# Server & Network Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
UPLOAD_DIRECTORY=backend/uploads
GENERATED_REPORTS_DIRECTORY=backend/generated_reports
MAX_UPLOAD_SIZE_MB=50

# Retrieval & Verification Thresholds
RETRIEVAL_TOP_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.45
